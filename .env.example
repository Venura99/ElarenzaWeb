DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

ADMIN_USERNAME="admin"
# Generate with: node scripts/hash-password.js "your-new-password"
# Note: Next.js expands $ characters in .env files, so escape every $ as \$
# in the hash the script prints (it already does this for you).
ADMIN_PASSWORD_HASH=""

