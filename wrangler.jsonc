{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "elarenza",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Prisma's default entry is its Node build, which loads the query engine
  // with fs.readFileSync — unavailable on workerd. Point it at the WASM build
  // that Prisma ships for worker runtimes.
  "alias": {
    ".prisma/client/default": "./node_modules/.prisma/client/wasm.js",
    "@prisma/client/default": "./node_modules/.prisma/client/wasm.js"
  },
  "observability": {
    "enabled": true
  }
}
