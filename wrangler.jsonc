{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "elarenzaweb",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Runtime configuration (Turso, Cloudinary, admin credentials) is set as
  // secrets in the dashboard rather than committed here, because this repo is
  // public. Without this flag wrangler treats the config as the source of
  // truth and strips those values on every deploy, taking the site down.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
