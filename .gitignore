# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database
/prisma/dev.db
/prisma/dev.db-journal

# uploaded product images
/public/uploads/*
!/public/uploads/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare local secrets
.dev.vars
.open-next/
.wrangler/

# Unredacted WhatsApp testimonial screenshots. These contain customers' phone
# numbers, profile photos and last-seen status. Only the cropped copies under
# public/images/testimonials are safe to publish, and git history is forever.
/customer feedback screenshots/
testimonial-review/
